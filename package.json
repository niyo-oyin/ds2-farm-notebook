{
  "name": "ds2-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:watch": "vite build --watch",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "server:dev": "node --watch --env-file-if-exists=.env --import tsx server/index.ts",
    "start": "npm run build && npm run server",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
