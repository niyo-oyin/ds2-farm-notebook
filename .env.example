# サーバ設定（server/index.ts 参照）。コピーして .env にする
PORT=8877
# SQLiteと画像の保存先を変える場合
# DS2_DB=server/data/ds2.sqlite

# 写真読み取り・愛馬の一篇: OpenAI 互換 Chat Completions（response_format: json_schema 対応が必要）
# 既定は Meta Model API の Muse Spark 1.3 Contributor。キーは https://dev.meta.ai で発行
LLM_API_KEY=
# 別の提供元を使う場合だけ指定（Meta 以外では馬の画像切り出し（SAM）が使えない）
# LLM_BASE_URL=https://api.meta.ai/v1
# LLM_MODEL=muse-spark-1.3-contributor
# SAM_MODEL=sam-3.1

# 外部公開する場合だけ設定（未設定なら認証なし）
DS2_TOKEN=
